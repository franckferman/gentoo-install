# gentoo-install — editor configuration
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

# Tab-separated data files: the tabs are the format.
[*.tsv]
indent_style = tab
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Upstream text, kept byte for byte.
[LICENSE]
insert_final_newline = false
trim_trailing_whitespace = false
